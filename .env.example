# העתק ל-.env והגדר מפתח (אופציונלי — ללא מפתח תופעל שגרה לפי כללים)
FLASK_SECRET_KEY=שנה-למחרוזת-אקראית-ארוכה
OPENAI_API_KEY=

# שרת אימות TCP (הרצה: py -3 run_auth_server.py)
AUTH_SOCKET_BIND_HOST=0.0.0.0
AUTH_SOCKET_PORT=5050
# כתובת שהלקוח (Flask / מחשב שני) מתחבר אליה
AUTH_SOCKET_HOST=127.0.0.1
